<view class="page">
  <!-- 月份选择 -->
  <view class="month-bar">
    <scroll-view scroll-x class="month-scroll" scroll-into-view="m{{month}}" scroll-with-animation>
      <view
        wx:for="{{months}}"
        wx:key="*this"
        id="m{{item}}"
        class="month-item {{item === month ? 'active' : ''}}"
        data-m="{{item}}"
        bindtap="chooseMonth"
      >{{item}}月</view>
    </scroll-view>
  </view>

  <!-- 地图（全屏） -->
  <map
    id="fruitMap"
    class="map"
    latitude="{{mapLat}}"
    longitude="{{mapLng}}"
    scale="{{mapScale}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
    bindlabeltap="onMarkerTap"
  ></map>

  <!-- 详情卡片 -->
  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
  <view class="detail" wx:if="{{showDetail}}">
    <view class="d-head">
      <view class="d-title">
        <text class="d-emoji">{{detailEmoji}}</text>
        <view class="d-title-r">
          <text class="d-name">{{detail.name}}</text>
          <text class="d-variety">{{detail.variety}}</text>
        </view>
      </view>
      <text class="d-close-x" bindtap="closeDetail">✕</text>
    </view>

    <view class="d-rows">
      <view class="d-row"><text class="d-label">产地</text><text>{{detail.province}} · {{detail.city}}</text></view>
      <view class="d-row"><text class="d-label">时令</text><text>{{detail.season}}</text></view>
    </view>

    <view class="d-sec" wx:if="{{detail.note}}"><view class="d-sec-title">赏味</view><view class="d-sec-text">{{detail.note}}</view></view>
    <view class="d-sec" wx:if="{{detail.pick}}"><view class="d-sec-title">挑选</view><view class="d-sec-text">{{detail.pick}}</view></view>
    <view class="d-sec" wx:if="{{detail.identify}}"><view class="d-sec-title">鉴别</view><view class="d-sec-text">{{detail.identify}}</view></view>

    <view class="d-tip">⚠️ 避坑：{{detail.tip}}</view>

    <view class="d-actions">
      <view class="d-big-btn {{detailFav ? 'on' : ''}}" bindtap="onToggleFav">{{detailFav ? '♥ 已收藏' : '♡ 收藏'}}</view>
      <view class="d-big-btn check {{detailChecked ? 'on' : ''}} {{canCheckin ? '' : 'disabled'}}" bindtap="onToggleCheckin">{{detailChecked ? '✓ 已尝' : '＋ 打卡'}}</view>
    </view>
    <button class="d-feedback" open-type="contact" session-from="果实：{{detail.name}}（{{detail.province}}{{detail.city}}）">纠错反馈</button>
  </view>
</view>
