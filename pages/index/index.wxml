<view class="page">
  <!-- 月份选择 -->
  <view class="month-bar">
    <scroll-view scroll-x class="month-scroll" scroll-into-view="m{{month}}" scroll-with-animation>
      <view
        wx:for="{{months}}"
        wx:key="*this"
        id="m{{item}}"
        class="month-item {{item === month ? 'active' : ''}}"
        data-m="{{item}}"
        bindtap="chooseMonth"
      >{{item}}月</view>
    </scroll-view>
  </view>

  <!-- 搜索 + 省份筛选（原搜索页并入） -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜水果 / 品种 / 产地" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
  </view>
  <scroll-view scroll-x class="province-scroll">
    <view
      wx:for="{{provinces}}"
      wx:key="name"
      class="province-item {{item.name === province ? 'active' : ''}}"
      data-p="{{item.name}}"
      bindtap="onProvinceTap"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 地图 -->
  <map
    id="fruitMap"
    class="map"
    latitude="{{mapLat}}"
    longitude="{{mapLng}}"
    scale="{{mapScale}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
    bindlabeltap="onMarkerTap"
  ></map>

  <!-- 列表 -->
  <view class="list-panel">
    <view class="list-head">{{listTitle}} <text class="c-orange">{{list.length}}</text> 种</view>
    <scroll-view scroll-y class="list">
      <view
        class="list-item"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onListTap"
      >
        <view class="li-main">
          <text class="li-name">{{item.name}}</text>
          <text class="li-tag">露天</text>
        </view>
        <view class="li-sub">{{item.province}} · {{item.city}} · {{item.season}}</view>
      </view>
      <view class="empty-state" wx:if="{{list.length === 0}}">
        <text class="emoji">🍂</text>没有找到相关果实
      </view>
    </scroll-view>
  </view>

  <!-- 详情卡片 -->
  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
  <view class="detail" wx:if="{{showDetail}}">
    <view class="d-head">
      <text class="d-name">{{detail.name}}</text>
      <view class="d-toggles">
        <text class="d-fav {{detailFav ? 'on' : ''}}" bindtap="onToggleFav">{{detailFav ? '♥ 已收藏' : '♡ 收藏'}}</text>
        <text class="d-check {{detailChecked ? 'on' : ''}}" bindtap="onToggleCheckin">{{detailChecked ? '✓ 已尝' : '＋ 打卡'}}</text>
      </view>
    </view>
    <view class="d-row"><text class="d-label">产地</text><text>{{detail.province}} · {{detail.city}}</text></view>
    <view class="d-row"><text class="d-label">赏味</text><text>{{detail.season}}</text></view>
    <view class="d-row"><text class="d-label">品种</text><text>{{detail.variety}}</text></view>
    <view class="d-tip">避坑提示：{{detail.tip}}</view>
    <view class="d-actions">
      <button class="d-contact" open-type="contact" session-from="果实：{{detail.name}}（{{detail.province}}{{detail.city}}）">纠错反馈</button>
      <view class="d-close" bindtap="closeDetail">知道了</view>
    </view>
  </view>
</view>
