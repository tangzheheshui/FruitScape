.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 月份选择 */
.month-bar {
  background: #ffffff;
  padding: 12rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  z-index: 2;
}
.month-scroll { white-space: nowrap; height: 60rpx; }
.month-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #5a645a;
  background: #f0f4ec;
}
.month-item:first-child { margin-left: 20rpx; }
.month-item:last-child { margin-right: 20rpx; }
.month-item.active { background: #e8853c; color: #ffffff; font-weight: 600; }

/* 地图（填满剩余空间） */
.map {
  flex: 1;
  width: 100%;
  min-height: 0;
}

/* 详情卡片 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 10;
}
.detail {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 11;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.d-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.d-title { display: flex; align-items: center; }
.d-emoji { font-size: 60rpx; margin-right: 18rpx; line-height: 1; }
.d-name { display: block; font-size: 38rpx; font-weight: 700; color: #2e3a2e; }
.d-variety { display: block; font-size: 24rpx; color: #9aa39a; margin-top: 6rpx; }
.d-close-x { color: #c0c6c0; font-size: 36rpx; padding: 0 8rpx; }

.d-rows {
  margin-top: 24rpx;
  background: #f6faf0;
  border-radius: 14rpx;
  padding: 4rpx 20rpx;
}
.d-row { display: flex; align-items: center; padding: 14rpx 0; }
.d-label { color: #9aa39a; font-size: 24rpx; width: 120rpx; flex-shrink: 0; }
.d-row text:last-child { font-size: 28rpx; color: #333333; }

.d-sec { margin-top: 24rpx; }
.d-sec-title {
  font-size: 24rpx;
  color: #e8853c;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.d-sec-text { font-size: 27rpx; color: #333333; line-height: 1.55; }

.d-tip {
  margin-top: 24rpx;
  background: #fbf4ea;
  color: #b08a5c;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  line-height: 1.5;
}

.d-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}
.d-big-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #e8853c;
  background: #fbf4ea;
}
.d-big-btn.on { background: #e8853c; color: #ffffff; }
.d-big-btn.check { color: #6fa95c; background: #edf5e8; }
.d-big-btn.check.on { background: #6fa95c; color: #ffffff; }
.d-big-btn.disabled { opacity: 0.4; }
.d-feedback {
  margin-top: 14rpx;
  width: 100%;
  background: transparent;
  color: #9aa39a;
  font-size: 24rpx;
  text-align: center;
  padding: 6rpx 0;
  line-height: 1.5;
}
.d-feedback::after { border: none; }
