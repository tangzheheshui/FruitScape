.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 月份选择 */
.month-bar {
  background: #ffffff;
  padding: 12rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  z-index: 2;
}
.month-scroll { white-space: nowrap; height: 60rpx; }
.month-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #5a645a;
  background: #f0f4ec;
}
.month-item:first-child { margin-left: 20rpx; }
.month-item:last-child { margin-right: 20rpx; }
.month-item.active { background: #e8853c; color: #ffffff; font-weight: 600; }

/* 搜索 + 省份 */
.search-bar { padding: 12rpx 24rpx 4rpx; }
.search-input {
  background: #f0f4ec;
  border-radius: 32rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.province-scroll { white-space: nowrap; padding: 8rpx 0 12rpx; }
.province-item {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin: 0 8rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #5a645a;
  background: #ffffff;
  border: 1rpx solid #e0e5e0;
}
.province-item:first-child { margin-left: 20rpx; }
.province-item.active { background: #e8853c; color: #ffffff; border-color: #e8853c; }

/* 地图（加大面积） */
.map {
  width: 100%;
  height: 52vh;
}

/* 列表（卡片缩小） */
.list-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.list-head {
  padding: 16rpx 24rpx 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2e3a2e;
}
.c-orange { color: #e8853c; }
.list { flex: 1; }
.list-item {
  background: #ffffff;
  margin: 8rpx 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.li-main { display: flex; align-items: center; }
.li-name { font-size: 28rpx; font-weight: 600; color: #2e3a2e; }
.li-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #6fa95c;
  background: #edf5e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.li-sub { color: #8a948a; font-size: 22rpx; margin-top: 4rpx; }
.empty-state { text-align: center; color: #9aa39a; font-size: 26rpx; padding: 40rpx 0; }
.emoji { display: block; font-size: 50rpx; margin-bottom: 10rpx; }

/* 详情卡片 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 10;
}
.detail {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 11;
}
.d-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.d-name { font-size: 36rpx; font-weight: 700; color: #2e3a2e; }
.d-toggles { display: flex; gap: 16rpx; }
.d-fav, .d-check { color: #9aa39a; font-size: 26rpx; }
.d-fav.on { color: #e8853c; font-weight: 600; }
.d-check.on { color: #6fa95c; font-weight: 600; }
.d-row {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #333333;
  display: flex;
  align-items: center;
}
.d-label { color: #9aa39a; font-size: 24rpx; width: 120rpx; flex-shrink: 0; }
.d-tip {
  margin-top: 22rpx;
  background: #fbf4ea;
  color: #b08a5c;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 12rpx;
}
.d-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}
.d-contact {
  flex: 1;
  background: #f6faf0;
  color: #6fa95c;
  border: 1rpx solid #d9e4d2;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  line-height: 1.5;
}
.d-contact::after { border: none; }
.d-close {
  flex: 1;
  text-align: center;
  background: #e8853c;
  color: #ffffff;
  padding: 20rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
}
