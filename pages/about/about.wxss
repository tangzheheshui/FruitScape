.about {
  padding: 40rpx 32rpx 80rpx;
}
.brand {
  text-align: center;
  padding: 40rpx 0 24rpx;
}
.brand-logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  background: #6fa95c;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  border-radius: 28rpx;
}
.brand-name {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #2e3a2e;
}
.brand-slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #e8853c;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e3a2e;
  margin-bottom: 12rpx;
}
.sec-body {
  font-size: 26rpx;
  color: #5a645a;
  line-height: 1.7;
}

.link {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6fa95c;
}

.contact-btn {
  margin-top: 20rpx;
  background: #e8853c;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 44rpx;
}
.contact-btn::after { border: none; }

.version {
  margin-top: 40rpx;
  text-align: center;
  color: #b8c0b8;
  font-size: 24rpx;
}
