<view class="poster-page">
  <view class="tip-bar">预览 · 保存后可直接发小红书 / 朋友圈</view>

  <view class="canvas-wrap" style="width: {{W}}px; height: {{canvasH}}px;">
    <canvas type="2d" id="poster" style="width: {{W}}px; height: {{canvasH}}px;"></canvas>
  </view>

  <button class="save-btn" bindtap="save" disabled="{{saving}}">
    {{saving ? '生成中…' : '保存到相册'}}
  </button>
</view>
