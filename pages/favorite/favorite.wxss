.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6faf0;
}
.tabs {
  display: flex;
  background: #ffffff;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #8a948a;
  border-bottom: 4rpx solid transparent;
}
.tab.active {
  color: #e8853c;
  font-weight: 600;
  border-bottom-color: #e8853c;
}
.list { flex: 1; min-height: 0; }
.item {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 12rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.item-body { flex: 1; }
.item-name { font-size: 30rpx; font-weight: 600; color: #2e3a2e; }
.tag {
  font-size: 20rpx;
  color: #6fa95c;
  background: #edf5e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.tag.fav { color: #e8853c; background: #fbf4ea; }
.item-sub { color: #8a948a; font-size: 24rpx; margin-top: 6rpx; }
.del {
  color: #9aa39a;
  font-size: 24rpx;
  border: 1rpx solid #e0e5e0;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}
.empty-state {
  text-align: center;
  color: #9aa39a;
  font-size: 26rpx;
  padding: 80rpx 0;
}
.emoji { display: block; font-size: 60rpx; margin-bottom: 16rpx; }
.footer {
  text-align: center;
  color: #9aa39a;
  font-size: 24rpx;
  padding: 12rpx 0 32rpx;
}
