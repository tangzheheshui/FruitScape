<view class="page">
  <scroll-view scroll-y class="list" wx:if="{{list.length > 0}}">
    <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goFruit">
      <view class="item-body">
        <view class="item-name">{{item.name}}</view>
        <view class="item-sub">{{item.province}} · {{item.city}} · {{item.season}}</view>
      </view>
      <view class="del" data-id="{{item.id}}" catchtap="remove">取消</view>
    </view>
  </scroll-view>

  <view class="empty-state" wx:if="{{list.length === 0}}">
    <text class="emoji">♡</text>
    还没有收藏，去首页看看当季果实吧
  </view>
</view>
