.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.tabs {
  display: flex;
  background: #ffffff;
  padding: 16rpx 24rpx;
  gap: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 32rpx;
  background: #f0f4ec;
  color: #5a645a;
  font-size: 28rpx;
}
.tab.active {
  background: #e8853c;
  color: #ffffff;
  font-weight: 600;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}
.search-btn {
  background: #6fa95c;
  color: #ffffff;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.result-list { flex: 1; }
.result-item {
  background: #ffffff;
  margin: 12rpx 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.ri-main { display: flex; align-items: center; }
.ri-name { font-size: 30rpx; font-weight: 600; color: #2e3a2e; }
.ri-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #6fa95c;
  background: #edf5e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.ri-sub { color: #8a948a; font-size: 24rpx; margin-top: 6rpx; }
.ri-tip { color: #b08a5c; font-size: 22rpx; margin-top: 8rpx; }

.hint {
  padding: 100rpx 40rpx;
  text-align: center;
  color: #9aa39a;
  font-size: 26rpx;
}

/* 省份模式 */
.province-wrap {
  flex: 1;
  display: flex;
  min-height: 0;
}
.province-list {
  width: 220rpx;
  background: #ffffff;
}
.province-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: #5a645a;
}
.province-item.active {
  background: #f6faf0;
  color: #e8853c;
  font-weight: 600;
}
.pc { font-size: 22rpx; color: #b8c0b8; }
.province-detail {
  flex: 1;
  border-left: 1rpx solid #eef2ec;
}
.pd-title {
  padding: 20rpx 24rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2e3a2e;
}
