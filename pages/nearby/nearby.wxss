.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 月份选择 */
.month-bar {
  background: #ffffff;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  z-index: 2;
}
.month-scroll {
  white-space: nowrap;
  height: 64rpx;
}
.month-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #5a645a;
  background: #f0f4ec;
}
.month-item:first-child { margin-left: 20rpx; }
.month-item:last-child { margin-right: 20rpx; }
.month-item.active {
  background: #e8853c;
  color: #ffffff;
  font-weight: 600;
}

/* 子模式切换 */
.sub-tabs {
  display: flex;
  background: #ffffff;
  padding: 16rpx 24rpx;
  gap: 20rpx;
  border-top: 1rpx solid #f0f2f0;
}
.sub-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 32rpx;
  background: #f0f4ec;
  color: #5a645a;
  font-size: 26rpx;
}
.sub-tab.active {
  background: #6fa95c;
  color: #ffffff;
  font-weight: 600;
}

/* 定位排序 */
.head-card {
  background: #ffffff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.hc-title { font-size: 32rpx; font-weight: 600; color: #2e3a2e; }
.hc-note { margin-top: 10rpx; font-size: 24rpx; color: #9aa39a; }
.locate-btn {
  margin-top: 24rpx;
  background: #e8853c;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 44rpx;
}
.locate-btn[disabled] { opacity: 0.6; color: #ffffff; }

.list { flex: 1; }
.item {
  background: #ffffff;
  margin: 12rpx 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.item-main { display: flex; justify-content: space-between; align-items: center; }
.item-name { font-size: 30rpx; font-weight: 600; color: #2e3a2e; }
.item-dist { font-size: 26rpx; color: #e8853c; font-weight: 600; }
.item-tag { font-size: 24rpx; color: #6fa95c; }
.item-sub { color: #8a948a; font-size: 24rpx; margin-top: 6rpx; }
.item-tip { color: #b08a5c; font-size: 22rpx; margin-top: 8rpx; }

.empty-state .link {
  display: block;
  margin-top: 16rpx;
  color: #e8853c;
  text-decoration: underline;
}

/* 按省份查 */
.province-detail { flex: 1; }
.province-chips {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 4rpx;
  gap: 16rpx;
}
.chip {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #5a645a;
  font-size: 24rpx;
}
.chip.active {
  background: #6fa95c;
  color: #ffffff;
  font-weight: 600;
}
.pd-title {
  padding: 20rpx 24rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2e3a2e;
}
.hint {
  padding: 100rpx 40rpx;
  text-align: center;
  color: #9aa39a;
  font-size: 26rpx;
}
