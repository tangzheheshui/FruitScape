.page {
  background: #f6faf0;
  padding: 20rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.slogan {
  font-size: 24rpx;
  color: #9aa39a;
  margin: 4rpx 8rpx 20rpx;
}

/* 卡片块 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2e3a2e;
  margin-bottom: 14rpx;
}
.card-body {
  font-size: 26rpx;
  color: #5a645a;
  line-height: 1.6;
}

/* 圆形进度 */
.rings {
  display: flex;
  justify-content: space-around;
}
.ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ring {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-inner {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-num { font-size: 34rpx; font-weight: 700; color: #2e3a2e; }
.ring-total { font-size: 22rpx; font-weight: 400; color: #9aa39a; }
.ring-label { margin-top: 14rpx; font-size: 24rpx; color: #8a948a; }

/* 当月应季列表 */
.item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3ef;
}
.item:last-child { border-bottom: none; }
.i-name { font-size: 30rpx; font-weight: 600; color: #2e3a2e; }
.i-tag {
  font-size: 20rpx;
  color: #6fa95c;
  background: #edf5e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.i-sub { color: #8a948a; font-size: 24rpx; margin-top: 6rpx; }
.empty { text-align: center; color: #9aa39a; font-size: 26rpx; padding: 40rpx 0; }

.share {
  margin-top: 8rpx;
  text-align: center;
  background: #e8853c;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 44rpx;
}
