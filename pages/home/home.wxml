<view class="page">
  <view class="slogan">看露天应季水果 · 拒绝大棚反季</view>

  <!-- 进度卡片 -->
  <view class="card">
    <view class="rings">
      <view class="ring-wrap">
        <view class="ring" style="background: conic-gradient(#E8853C 0% {{yearPct}}%, #E9F0E4 {{yearPct}}% 100%);">
          <view class="ring-inner">
            <text class="ring-num">{{yearDone}}<text class="ring-total">/{{yearTotal}}</text></text>
          </view>
        </view>
        <text class="ring-label">全年已尝</text>
      </view>
      <view class="ring-wrap">
        <view class="ring" style="background: conic-gradient(#6FA95C 0% {{monthPct}}%, #E9F0E4 {{monthPct}}% 100%);">
          <view class="ring-inner">
            <text class="ring-num">{{monthDone}}<text class="ring-total">/{{monthTotal}}</text></text>
          </view>
        </view>
        <text class="ring-label">当月已尝</text>
      </view>
    </view>
  </view>

  <!-- 即将上市 -->
  <view class="card" wx:if="{{comingSoonNames}}">
    <view class="card-title">🌱 即将上市</view>
    <view class="card-body">{{comingSoonNames}}</view>
  </view>

  <!-- 当月应季 -->
  <view class="card">
    <view class="card-title">{{monthLabel}}露天应季（{{monthList.length}} 种）</view>
    <view class="item" wx:for="{{monthList}}" wx:key="id" data-id="{{item.id}}" bindtap="goFruit">
      <view class="i-name">{{item.city}} {{item.variety}} <text class="i-tag">露天</text></view>
      <view class="i-sub">{{item.name}} · {{item.province}} · {{item.season}}</view>
    </view>
    <view wx:if="{{monthList.length === 0}}" class="empty">这个月暂时没有录入露天果实 🍂</view>
  </view>

  <view class="share" bindtap="goPoster">生成分享图</view>
</view>
