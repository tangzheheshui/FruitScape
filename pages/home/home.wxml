<view class="page">
  <view class="header">
    <view class="brand">时令果册</view>
    <view class="slogan">看露天应季水果 · 拒绝大棚反季</view>
  </view>

  <view class="cards">
    <view class="card">
      <view class="c-label">全年图鉴</view>
      <view class="c-num">{{yearDone}}<text class="c-total">/{{yearTotal}}</text></view>
      <view class="c-desc">已尝 {{yearDone}} 种露天应季水果</view>
      <view class="bar"><view class="bar-fill" style="width:{{yearPct}}%"></view></view>
    </view>
    <view class="card orange">
      <view class="c-label">{{monthLabel}}应季</view>
      <view class="c-num">{{monthDone}}<text class="c-total">/{{monthTotal}}</text></view>
      <view class="c-desc">本月已尝</view>
      <view class="bar"><view class="bar-fill" style="width:{{monthPct}}%"></view></view>
    </view>
  </view>

  <!-- 提醒 -->
  <view class="tips" wx:if="{{comingSoonNames}}">
    <view class="tip-line">🌱 即将上市：{{comingSoonNames}}</view>
  </view>

  <view class="list-head">{{monthLabel}}露天应季（{{monthList.length}} 种）</view>
  <scroll-view scroll-y class="list">
    <view class="item" wx:for="{{monthList}}" wx:key="id" data-id="{{item.id}}" bindtap="goFruit">
      <view class="i-name">{{item.name}} <text class="i-tag">露天</text></view>
      <view class="i-sub">{{item.province}} · {{item.city}} · {{item.season}}</view>
    </view>
    <view wx:if="{{monthList.length === 0}}" class="empty">这个月暂时没有录入露天果实 🍂</view>
  </scroll-view>

  <view class="share" bindtap="goPoster">生成分享图</view>
</view>
